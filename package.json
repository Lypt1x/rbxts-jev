{
	"name": "@rbxts/jev",
	"version": "0.1.0",
	"description": "Typed, functional TypeSafe Jev client for Roblox. Ask many questions about one state, get typed decisions back.",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": [
		"out",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rbxtsc",
		"watch": "rbxtsc -w",
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.node.json --noEmit",
		"check": "npm run build && npm run typecheck && npm test",
		"prepack": "npm run build",
		"test:studio": "bash scripts/studio-test.sh",
		"test:cloud": "bash scripts/build-place.sh && node scripts/cloud-test.mjs wire",
		"test:live": "bash scripts/build-place.sh && node scripts/cloud-test.mjs live",
		"prepare": "npm run build",
		"docs:build": "npm --prefix docs run build",
		"docs:start": "npm --prefix docs run start",
		"docs:check": "node scripts/check-docs.mjs"
	},
	"keywords": [
		"roblox",
		"roblox-ts",
		"rbxts",
		"typesafe",
		"jev",
		"ai",
		"decision"
	],
	"license": "MIT",
	"devDependencies": {
		"@rbxts/compiler-types": "^3.0.0-types.0",
		"@rbxts/types": "^1.0.958",
		"@types/bun": "^1.4.3",
		"roblox-ts": "^3.0.0",
		"typescript": "^5.9.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Lypt1x/rbxts-jev.git"
	},
	"homepage": "https://github.com/Lypt1x/rbxts-jev#readme",
	"bugs": {
		"url": "https://github.com/Lypt1x/rbxts-jev/issues"
	}
}
