{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ES2022"
		],
		"types": [
			"bun"
		],
		"strict": true,
		"exactOptionalPropertyTypes": false,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": [
		"src/core",
		"test"
	],
	"exclude": [
		"test/fixture"
	]
}
